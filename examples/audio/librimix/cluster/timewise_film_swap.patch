+class TimeWiseFiLM(nn.Module):
+    """Frame-wise FiLM for cross-attended token cues."""
+
+    def __init__(
+        self,
+        embed_dim,
+        feat_dim,
+        scale=0.1,
+        init_std=0.0,
+        bound=True,
+    ):
+        super().__init__()
+        self.gamma_proj = nn.Linear(embed_dim, feat_dim)
+        self.beta_proj = nn.Linear(embed_dim, feat_dim)
+        self.scale = scale
+        self.bound = bound
+        self.init_weights(init_std)
+
+    def init_weights(self, init_std):
+        if init_std and init_std > 0:
+            nn.init.normal_(self.gamma_proj.weight, mean=0.0, std=init_std)
+            nn.init.normal_(self.beta_proj.weight, mean=0.0, std=init_std)
+        else:
+            nn.init.zeros_(self.gamma_proj.weight)
+            nn.init.zeros_(self.beta_proj.weight)
+        nn.init.zeros_(self.gamma_proj.bias)
+        nn.init.zeros_(self.beta_proj.bias)
+
+    def forward(self, x, embed):
+        if x.dim() == 3:
+            h = embed.transpose(1, 2)  # (B, T, E)
+            gamma = self.gamma_proj(h).transpose(1, 2)
+            beta = self.beta_proj(h).transpose(1, 2)
+        elif x.dim() == 4:
+            h = embed.transpose(2, 3)  # (B, band, T, E)
+            gamma = self.gamma_proj(h).transpose(2, 3)
+            beta = self.beta_proj(h).transpose(2, 3)
+        else:
+            raise ValueError(f"Unsupported x shape for TimeWiseFiLM: {x.shape}")
+
+        if self.bound:
+            gamma = torch.tanh(gamma)
+            beta = torch.tanh(beta)
+        return ((1.0 + self.scale * gamma) * x + self.scale * beta).contiguous()
+
